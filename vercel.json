{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "fra1"
  ],
  "proxy": {
    "entrypoint": "proxy.mjs"
  },
  "redirects": [
    {
      "source": "/start.html",
      "destination": "/ai-grager.html",
      "permanent": true
    },
    {
      "source": "/start",
      "destination": "/ai-grager.html",
      "permanent": true
    },
    {
      "source": "/level-up.html",
      "destination": "/ai-grager.html",
      "permanent": true
    },
    {
      "source": "/level-up",
      "destination": "/ai-grager.html",
      "permanent": true
    }
  ]
}
